// <auto-generated />
<#
    // This template writes DistortionWeightTable: the forward quantization weights of WeightTable, put in the order
    // in which av1_block_error_qm() pairs them with the coefficients. The weighted distortion kernel then reads the
    // weights with plain vector loads. A computed table needs memory at run time. A literal of constants is data in
    // the assembly and needs no allocation, so the template writes the values as constants.
    //
    // Run the template again when WeightTable or a default scan changes:
    //     t4 Av1QuantizationMatrixLookup.Distortion.tt -o Av1QuantizationMatrixLookup.Distortion.cs

    // The stored matrices, in the order of MatrixOffsets in Av1QuantizationMatrixLookup.cs, as (width, height).
    // The transform sizes with a 64-point side use the matrix and the scan of their 32-point adjusted size, so they
    // have no entry of their own.
    int[][] sizes =
    [
        [4, 4], [8, 8], [16, 16], [32, 32], [4, 8], [8, 4], [8, 16], [16, 8], [16, 32], [32, 16],
        [4, 16], [16, 4], [8, 32], [32, 8]
    ];

    // The number of weights in one plane class of one matrix level: the sum of width * height over the sizes above.
    // Reference: QM_TOTAL_SIZE.
    const int TotalSize = 3344;

    // Matrix levels 0 to 14, each with a luma and a chroma class. Level 15 is flat and is not stored.
    const int TableCount = 15 * 2;

    // The template reads its two inputs from the C# sources, so the tables have one definition only.
    // ResolvePath is relative to the folder of this template.
    string lookup = File.ReadAllText(this.Host.ResolvePath("Av1QuantizationMatrixLookup.cs"));
    string scans = File.ReadAllText(this.Host.ResolvePath(Path.Combine("..", "..", "Transform", "Av1ScanOrderConstants.cs")));

    // WeightTable holds the matrices in raster order: coefficient (row, column) of a width-wide matrix is at
    // row * width + column. Take every number between the brackets of its literal.
    Match weightMatch = Regex.Match(lookup, @"ReadOnlySpan<byte> WeightTable =>\s*\[(.*?)\];", RegexOptions.Singleline);
    int[] weights = Regex.Matches(weightMatch.Groups[1].Value, @"\d+").Cast<Match>().Select(m => int.Parse(m.Value)).ToArray();

    // A wrong count means that the literal has a different layout, or that the pattern did not find it.
    if (weights.Length != TotalSize * TableCount)
    {
        throw new InvalidOperationException($"WeightTable holds {weights.Length} weights.");
    }

    byte[] ordered = new byte[weights.Length];
    for (int table = 0; table < TableCount; table++)
    {
        // The first weight of the first matrix of this level and plane class. The output keeps the same layout, so
        // GetDistortionWeights() uses the same offsets as GetQuantizationMatrix().
        int start = table * TotalSize;
        foreach (int[] size in sizes)
        {
            int width = size[0];
            int height = size[1];

            // Only the default scan is needed. Every two-dimensional transform uses the default scan of its size,
            // and the other transform types use the flat matrix, where the order of the weights has no effect.
            Match scanMatch = Regex.Match(scans, $@"short\[\] DefaultScan{width}x{height}\s*=\s*\[(.*?)\];", RegexOptions.Singleline);
            int[] scan = Regex.Matches(scanMatch.Groups[1].Value, @"\d+").Cast<Match>().Select(m => int.Parse(m.Value)).ToArray();
            if (scan.Length != width * height)
            {
                throw new InvalidOperationException($"DefaultScan{width}x{height} holds {scan.Length} positions.");
            }

            // av1_block_error_qm() weights its coefficient i with qmatrix[scan[i]], and its coefficient i is in
            // column-major order. The coefficients here are in raster order, so raster coefficient (row, column)
            // is reference coefficient column * height + row, and its weight is the matrix entry at that scan
            // position. Write the weights in raster order of the coefficients.
            int index = start;
            for (int row = 0; row < height; row++)
            {
                for (int column = 0; column < width; column++)
                {
                    ordered[index++] = (byte)weights[start + scan[(column * height) + row]];
                }
            }

            // The next matrix starts directly after this one, in the order of MatrixOffsets.
            start += width * height;
        }
    }
#>

namespace SixLabors.ImageSharp.Formats.Heif.Av1.Pipeline.Quantizers;

/// <content>
/// Holds the forward weights in the order of the weighted distortion measure.
/// </content>
internal static partial class Av1QuantizationMatrixLookup
{
    /// <summary>
    /// Gets the forward weights of <see cref="WeightTable"/>, with each stored matrix in the order in which the
    /// weighted distortion measure pairs it with the raster coefficients here: coefficient <c>(row, column)</c> takes
    /// the entry at default scan position <c>column * height + row</c>. Reference: the <c>qmatrix[scan[i]]</c> read of
    /// av1_block_error_qm(), whose coefficient <c>i</c> is in column-major order.
    /// </summary>
    private static ReadOnlySpan<byte> DistortionWeightTable =>
    [
<#
    // Write the values eight spaces in, and wrap each line before it passes 116 characters. The last value has no
    // comma. Each line ends with '\n' so that the output has the same line ends as the other sources.
    StringBuilder line = new("       ");
    for (int i = 0; i < ordered.Length; i++)
    {
        string piece = i == ordered.Length - 1 ? $" {ordered[i]}" : $" {ordered[i]},";
        if (line.Length + piece.Length > 116)
        {
            this.Write(line.Append('\n').ToString());
            line.Clear().Append("       ");
        }

        line.Append(piece);
    }

    this.Write(line.Append('\n').ToString());
#>
    ];
}
