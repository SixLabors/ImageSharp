using SixLabors.ImageSharp.PixelFormats.PixelBlenders;

namespace SixLabors.ImageSharp.PixelFormats;

/// <content>
/// Provides fixed mode selectors and the runtime mode selector.
/// </content>
public static partial class PixelBlenders<TPixel>
    where TPixel : unmanaged, IPixel<TPixel>
{
#pragma warning disable CA1000 // The pixel type determines the shared blender instances.
    /// <summary>
    /// Gets the shared blender for the requested color blending and alpha composition modes.
    /// </summary>
    /// <param name="colorMode">The color blending mode. An unknown value selects normal color blending.</param>
    /// <param name="alphaMode">The alpha composition mode. An unknown value selects source-over composition.</param>
    /// <returns>The shared pixel blender.</returns>
    // Runtime selection references every supported mode. Fixed-mode callers use a named property,
    // so the trimmer can remove unused equations. Both paths return the same shared blender instances.
    public static PixelBlender<TPixel> GetPixelBlender(PixelColorBlendingMode colorMode, PixelAlphaCompositionMode alphaMode)
        => alphaMode switch
        {
<#
foreach (var composer in composers.Where(x => x != "SrcOver").Concat(new[] { "SrcOver" }))
{
    string alphaCase = composer == "SrcOver" ? "_" : $"PixelAlphaCompositionMode.{composer}";
#>
            <#= alphaCase #> => colorMode switch
            {
<#
    foreach (var blender in blenders.Where(x => x != "Normal"))
    {
#>
                PixelColorBlendingMode.<#= blender #> => <#= blender #><#= composer #>,
<#
    }
#>
                _ => Normal<#= composer #>,
            },
<#
}
#>
        };

    // Pixel metadata selects the required alpha representation. Each property references one equation per representation.
    // These properties do not call the runtime selector, so the trimmer can remove other modes.
<#
foreach (var composer in composers)
{
    foreach (var blender in blenders)
    {
        var blenderComposer = $"{blender}{composer}";
#>
    /// <summary>
    /// Gets the shared blender for <see cref="PixelColorBlendingMode.<#= blender #>"/> color blending
    /// and <see cref="PixelAlphaCompositionMode.<#= composer #>"/> alpha composition.
    /// </summary>
    public static PixelBlender<TPixel> <#= blenderComposer #> => TPixel.GetPixelTypeInfo().AlphaRepresentation == PixelAlphaRepresentation.Associated
        ? AssociatedAlphaPixelBlenders<TPixel>.<#= blenderComposer #>
        : DefaultPixelBlenders<TPixel>.<#= blenderComposer #>;

<#
    }
}
#>
#pragma warning restore CA1000 // The pixel type determines the shared blender instances.
}
