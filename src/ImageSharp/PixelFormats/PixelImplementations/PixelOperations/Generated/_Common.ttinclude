    void GenerateRgba32Compatible32BitVector4ConversionMethods(string pixelType)
    {
#>

        /// <inheritdoc />
        public override void FromVector4Destructive(Configuration configuration, Span<Vector4> sourceVectors, Span<<#=pixelType#>> destination)
        {
            Guard.DestinationShouldNotBeTooShort(sourceVectors, destination, nameof(destination));

            destination = destination[..sourceVectors.Length];
            PackFromVector4(sourceVectors, destination);
        }

        /// <inheritdoc />
        public override void FromScaledVector4Destructive(Configuration configuration, Span<Vector4> sourceVectors, Span<<#=pixelType#>> destination)
            => this.FromVector4Destructive(configuration, sourceVectors, destination);

        /// <inheritdoc />
        public override void FromUnassociatedVector4Destructive(Configuration configuration, Span<Vector4> sourceVectors, Span<<#=pixelType#>> destination)
            => this.FromVector4Destructive(configuration, sourceVectors, destination);

        /// <inheritdoc />
        public override void FromAssociatedVector4Destructive(Configuration configuration, Span<Vector4> sourceVectors, Span<<#=pixelType#>> destination)
        {
            Guard.DestinationShouldNotBeTooShort(sourceVectors, destination, nameof(destination));

            Numerics.UnPremultiply(sourceVectors);
            PackFromVector4(sourceVectors, destination[..sourceVectors.Length]);
        }

        /// <inheritdoc />
        public override void FromUnassociatedScaledVector4Destructive(Configuration configuration, Span<Vector4> sourceVectors, Span<<#=pixelType#>> destination)
            => this.FromVector4Destructive(configuration, sourceVectors, destination);

