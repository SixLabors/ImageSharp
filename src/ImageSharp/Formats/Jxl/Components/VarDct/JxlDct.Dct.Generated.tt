    /// <summary>
    /// Reconstructs 32-point columns with the existing radix-two arithmetic and no intermediate split copies.
    /// </summary>
    /// <typeparam name="TLanes">Independent column values, with one column in each scalar or SIMD lane.</typeparam>
    /// <typeparam name="TOperator">The existing arithmetic for those lanes.</typeparam>
    /// <param name="source">The first input column. All input rows must contain a complete lane batch.</param>
    /// <param name="sourceStride">The distance between input rows, in floats.</param>
    /// <param name="destination">The first output column. It can be the same location as the source.</param>
    /// <param name="destinationStride">The distance between output rows, in floats.</param>
    private static void Inverse32<TLanes, TOperator>(ref float source, int sourceStride, ref float destination, int destinationStride)
        where TLanes : unmanaged
        where TOperator : struct, ILaneOperator<TLanes>
    {
        ReadOnlySpan<float> multipliers4 = Multipliers4;
        ReadOnlySpan<float> multipliers8 = Multipliers8;
        ReadOnlySpan<float> multipliers16 = Multipliers16;
        ReadOnlySpan<float> multipliers32 = Multipliers32;

        // Load each frequency at its first arithmetic use. This keeps unused input values out of live registers.
        // All inputs are consumed before the final stores, so source and destination can still be the same rows.
        // Each lane follows the same unnormalized butterfly. The caller handles SIMD width and column remainders.
<#
    // Emit the existing C# inverse network, including its fixed four- and eight-point leaves. Only variable names
    // and graph connections are generated. All multipliers and the shared RootTwo coefficient remain in JxlDct.Tables.cs. This template
    // does not calculate trigonometric constants or introduce another rounded definition of a coefficient.
    // Preserve current+preceding add order, separate sqrt(2) multiplication and the existing multiply-add operators.
    // Regenerate with: t4 JxlDct.Dct.Generated.tt -o JxlDct.Dct.Generated.cs
    int next = 32;
    bool[] loadedInputs = new bool[32];

    // Writes input loads at their first use, then writes the unchanged arithmetic node. Only v0 through v31
    // denote source rows; later variables already hold arithmetic results. All loads precede the final output
    // stores because every source coefficient contributes to the complete network before those stores begin.
    string Emit(string expression)
    {
        foreach (Match match in Regex.Matches(expression, @"\bv([0-9]+)\b"))
        {
            int index = int.Parse(match.Groups[1].Value);
            if (index < loadedInputs.Length && !loadedInputs[index])
            {
                loadedInputs[index] = true;
                string source = index == 0 ? "ref source" : "ref Unsafe.Add(ref source, " + index + " * sourceStride)";
                WriteLine("        TLanes v" + index + " = TOperator.Load(" + source + ");");
            }
        }

        string variable = "v" + next++;
        WriteLine("        TLanes " + variable + " = " + expression + ";");
        return variable;
    }

    // Separates butterfly stages in the generated source.
    void Stage(string text)
    {
        WriteLine("");
        WriteLine("        // " + text);
    }

    // Joins transformed even and odd halves in the existing symmetric output order.
    string[] Merge(string[] even, string[] odd)
    {
        int half = even.Length;
        int length = 2 * half;
        string[] output = new string[length];
        Stage(length + "-point symmetric pairs retain separate positive and negative multiply-add operations.");
        for (int i = 0; i < half; i++)
        {
            string multiplier = "multipliers" + length + "[" + i + "]";
            output[i] = Emit("TOperator.MultiplyAdd(" + odd[i] + ", " + multiplier + ", " + even[i] + ")");
            output[length - i - 1] = Emit("TOperator.MultiplyAdd(" + odd[i] + ", -" + multiplier + ", " + even[i] + ")");
        }

        return output;
    }

    // Expands the existing radix-two graph while retaining each operation and its operand order.
    string[] Network(string[] input)
    {
        int length = input.Length;
        if (length == 4)
        {
            Stage("Four-point leaf: the even two-point transform, original odd sum, and separate sqrt(2) multiplication.");
            string even0 = Emit("TOperator.Add(" + input[0] + ", " + input[2] + ")");
            string even1 = Emit("TOperator.Subtract(" + input[0] + ", " + input[2] + ")");
            string adjacent = Emit("TOperator.Add(" + input[3] + ", " + input[1] + ")");
            string scaled = Emit("TOperator.Multiply(" + input[1] + ", RootTwo)");
            string odd0 = Emit("TOperator.Add(" + scaled + ", " + adjacent + ")");
            string odd1 = Emit("TOperator.Subtract(" + scaled + ", " + adjacent + ")");
            return Merge(new[] { even0, even1 }, new[] { odd0, odd1 });
        }

        int half = length / 2;
        string[] even = new string[half];
        string[] odd = new string[half];
        for (int i = 0; i < half; i++)
        {
            even[i] = input[2 * i];
            odd[i] = input[(2 * i) + 1];
        }

        // Graph generation selects these variables directly. There is no corresponding runtime even/odd copy.
        even = Network(even);
        string[] adjacentOdd = new string[half];
        Stage(length + "-point odd half: retain original neighbor sums and the separate sqrt(2) multiplication.");
        if (length == 8)
        {
            // Inverse8 uses separate locals, so it scales first and emits the independent neighbor sums in increasing order.
            adjacentOdd[0] = Emit("TOperator.Multiply(" + odd[0] + ", RootTwo)");
            for (int i = 1; i < half; i++)
            {
                adjacentOdd[i] = Emit("TOperator.Add(" + odd[i] + ", " + odd[i - 1] + ")");
            }
        }
        else
        {
            // The existing larger inverse loop traverses downward to preserve each original preceding coefficient.
            for (int i = half - 1; i > 0; i--)
            {
                adjacentOdd[i] = Emit("TOperator.Add(" + odd[i] + ", " + odd[i - 1] + ")");
            }

            adjacentOdd[0] = Emit("TOperator.Multiply(" + odd[0] + ", RootTwo)");
        }

        return Merge(even, Network(adjacentOdd));
    }

    string[] input = new string[32];
    for (int i = 0; i < input.Length; i++)
    {
        input[i] = "v" + i;
    }

    string[] output = Network(input);
    Stage("All frequency-dependent arithmetic is complete. Store each spatial row once, with no inverse 1/N scale.");
    for (int i = 0; i < output.Length; i++)
    {
        string destination = i == 0 ? "ref destination" : "ref Unsafe.Add(ref destination, " + i + " * destinationStride)";
        WriteLine("        TOperator.Store(" + output[i] + ", " + destination + ");");
    }
