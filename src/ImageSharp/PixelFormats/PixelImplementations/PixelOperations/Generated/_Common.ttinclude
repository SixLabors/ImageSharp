    /// <summary>
    /// Generates self-copy, packed shuffle and generic dispatch overrides for an associated byte layout.
    /// </summary>
    /// <param name="pixelType">The associated pixel type.</param>
    void GenerateAllAssociatedConversionMethods(string pixelType)
    {
        GenerateDefaultSelfConversionMethods(pixelType);

        foreach (string destinationType in AssociatedOptimizedPixelTypes.Where(p => p != pixelType))
        {
            GenerateOptimized32BitConversionMethods(pixelType, destinationType);
        }

        GenerateGenericConverterMethods(pixelType);
    }

