    /// <summary>
    /// Builds one scalar or full-register sample load at a validated relative position.
    /// </summary>
    /// <param name="bits">Zero for scalar loads, or the fixed SIMD register width.</param>
    /// <param name="x">The relative sample column.</param>
    /// <param name="y">The relative sample row.</param>
    /// <returns>The generated load expression.</returns>
    private static string Load(int bits, int x, int y)
    {
        string index = "index";
        if (y != 0)
        {
            index += y > 0 ? " + " : " - ";
            index += Math.Abs(y) == 1 ? "stride" : "(" + Math.Abs(y) + " * stride)";
        }

        if (x != 0)
        {
            index += (x > 0 ? " + " : " - ") + Math.Abs(x);
        }

        return bits == 0 ? "Unsafe.Add(ref source, " + index + ")"
            : "Vector" + bits + ".LoadUnsafe(ref source, (uint)(" + index + "))";
    }

    /// <summary>
    /// Retains the native four-, five-, seven- and nine-input Sum parenthesization.
    /// </summary>
    /// <param name="values">The ordered sample expressions for one ray.</param>
    /// <returns>The native addition expression.</returns>
    private static string Sum(string[] values)
    {
        if (values.Length == 4)
        {
            return "((" + values[0] + " + " + values[1] + ") + (" + values[2] + " + " + values[3] + "))";
        }

        if (values.Length == 5)
        {
            return Sum(new[] { values[0], values[1], values[2], "(" + values[3] + " + " + values[4] + ")" });
        }

        if (values.Length == 7)
        {
            return Sum(new[] { values[0], values[1], values[2], Sum(values.Skip(3).ToArray()) });
        }

        return "((" + Sum(values.Take(4).ToArray()) + " + " + Sum(values.Skip(4).Take(4).ToArray()) + ") + " + values[8] + ")";
    }
