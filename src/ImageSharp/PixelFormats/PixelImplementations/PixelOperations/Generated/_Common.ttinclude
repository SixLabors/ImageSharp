    void GenerateOptimized32BitConversionMethods(string pixelType, string otherType)
    {
        // PixelConverter's byte shuffles change channel order only. The same operations serve both alpha representations.
        string thisConverterType = pixelType.EndsWith("P") ? pixelType.Substring(0, pixelType.Length - 1) : pixelType;
        string otherConverterType = otherType.EndsWith("P") ? otherType.Substring(0, otherType.Length - 1) : otherType;
        string destination = pixelType.EndsWith("P") ? "destination.Slice(0, source.Length)" : "destination";

