    /// <summary>
    /// Emits a scalar constant or broadcasts the same float bits to every independent lane.
    /// </summary>
    /// <param name="lanes">The number of lanes in the generated type.</param>
    /// <param name="expression">The scalar expression.</param>
    /// <returns>The typed expression.</returns>
    private static string Splat(int lanes, string expression)
        => lanes == 1 ? expression : "Vector" + (lanes * 32) + ".Create(" + expression + ")";

    /// <summary>
    /// Emits one named intermediate so generated butterflies do not duplicate calculations.
    /// </summary>
    /// <param name="expression">The arithmetic expression.</param>
    /// <param name="lanes">The number of independent lanes.</param>
    /// <param name="statements">The statements in execution order.</param>
    /// <param name="temporary">The next local-variable index.</param>
    /// <returns>The emitted variable name.</returns>
    private static string Emit(string expression, int lanes, List<string> statements, ref int temporary)
    {
        string name = "v" + temporary++;
        string type = lanes == 1 ? "float" : "Vector" + (lanes * 32) + "<float>";
        statements.Add(type + " " + name + " = " + expression + ";");

        return name;
    }

    /// <summary>
    /// Expands the Perera-Liu radix-two equations using the existing constant tables and native multiply-add sites.
    /// </summary>
    /// <param name="input">The input variables, in transform order.</param>
    /// <param name="inverse">Whether to emit the inverse transform.</param>
    /// <param name="lanes">The number of independent lanes.</param>
    /// <param name="weights">The unchanged scalar literals read from JxlDctScales.</param>
    /// <param name="statements">The generated statements.</param>
    /// <param name="temporary">The next local-variable index.</param>
    /// <returns>The output variables, in transform order.</returns>
    private static string[] Expand(
        string[] input,
        bool inverse,
        int lanes,
        Dictionary<int, string[]> weights,
        List<string> statements,
        ref int temporary)
    {
        int count = input.Length;
        if (count == 1)
        {
            return input;
        }

        if (count == 2)
        {
            return new[]
            {
                Emit(input[0] + " + " + input[1], lanes, statements, ref temporary),
                Emit(input[0] + " - " + input[1], lanes, statements, ref temporary)
            };
        }

        int half = count / 2;
        string[] even = new string[half];
        string[] odd = new string[half];
        string vector = lanes == 1 ? "float" : "Vector" + (lanes * 32);
        if (inverse)
        {
            for (int i = 0; i < half; i++)
            {
                even[i] = input[2 * i];
                odd[i] = input[(2 * i) + 1];
            }

            even = Expand(even, true, lanes, weights, statements, ref temporary);
            for (int i = half - 1; i > 0; i--)
            {
                odd[i] = Emit(odd[i] + " + " + odd[i - 1], lanes, statements, ref temporary);
            }

            odd[0] = Emit(odd[0] + " * " + Splat(lanes, "JxlDctScales.Sqrt2"), lanes, statements, ref temporary);
            odd = Expand(odd, true, lanes, weights, statements, ref temporary);
            string[] output = new string[count];
            for (int i = 0; i < half; i++)
            {
                string weight = Splat(lanes, weights[count][i]);
                output[i] = Emit(vector + ".MultiplyAddEstimate(" + weight + ", " + odd[i] + ", " + even[i] + ")", lanes, statements, ref temporary);
                output[count - i - 1] = Emit(
                    vector + ".MultiplyAddEstimate(-" + weight + ", " + odd[i] + ", " + even[i] + ")", lanes, statements, ref temporary);
            }

            return output;
        }

        for (int i = 0; i < half; i++)
        {
            even[i] = Emit(input[i] + " + " + input[count - i - 1], lanes, statements, ref temporary);
            odd[i] = Emit("(" + input[i] + " - " + input[count - i - 1] + ") * " + Splat(lanes, weights[count][i]), lanes, statements, ref temporary);
        }

        even = Expand(even, false, lanes, weights, statements, ref temporary);
        odd = Expand(odd, false, lanes, weights, statements, ref temporary);
        odd[0] = Emit(
            vector + ".MultiplyAddEstimate(" + odd[0] + ", " + Splat(lanes, "JxlDctScales.Sqrt2") + ", " + odd[1] + ")", lanes, statements, ref temporary);
        for (int i = 1; i + 1 < half; i++)
        {
            odd[i] = Emit(odd[i] + " + " + odd[i + 1], lanes, statements, ref temporary);
        }

        return Enumerable.Range(0, count).Select(i => (i & 1) == 0 ? even[i / 2] : odd[i / 2]).ToArray();
    }

    /// <summary>
    /// Emits the existing shared integer transpose call. Reinterpretation preserves every floating-point bit.
    /// </summary>
    /// <param name="lanes">The square tile dimension.</param>
    /// <param name="indent">The generated indentation.</param>
    private void WriteTransposeCall(int lanes, int indent)
    {
        string prefix = new string(' ', indent);
        string[] arguments = Enumerable.Range(0, lanes).Select(i => "ref row" + i).ToArray();
        string call = prefix + "SimdUtils.Transpose(" + string.Join(", ", arguments) + ");";
        if (call.Length <= 160)
        {
            this.WriteLine(call);
        }
        else
        {
            this.WriteLine(prefix + "SimdUtils.Transpose(");
            for (int i = 0; i < lanes; i++)
            {
                this.WriteLine(prefix + "    " + arguments[i] + (i + 1 == lanes ? ");" : ","));
            }

            this.WriteLine("");
        }
    }
#>
